# Copy values into the shell or a local untracked .env before first startup.
COREHR_DB_PASSWORD=replace-with-a-long-random-password
COREHR_BOOTSTRAP_TOKEN=replace-with-a-one-time-random-bootstrap-token
# JSON keyring. Every value must be an independently generated Base64-encoded 32-byte key.
COREHR_PERSONNEL_ENCRYPTION_KEYS={"v1":"replace-with-base64-32-byte-key"}
COREHR_PERSONNEL_ACTIVE_KEY_VERSION=v1
# Must be different from every encryption key.
COREHR_PERSONNEL_SEARCH_KEY=replace-with-different-base64-32-byte-key
